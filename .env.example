# Environment variables — loaded for the "default" device
# Additional devices are registered in config/devices.yaml

# ── Default device credentials ─────────────────────────────────────────────
FORTIGATE_HOST=https://10.0.0.1
FORTIGATE_API_TOKEN=your-api-token-here
FORTIGATE_VDOM=root

# ── TLS ────────────────────────────────────────────────────────────────────
# Set to "true" only when connecting to a device with a self-signed cert
FORTIGATE_INSECURE=false

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
