# config/devices.yaml.example
# ──────────────────────────────────────────────────────────────────────────────
# Template for config/devices.yaml
# COPY this file to config/devices.yaml and fill in your real device info.
# The .yaml file is git-ignored; the .example file is tracked.
# ──────────────────────────────────────────────────────────────────────────────

devices:
  # ── Example: Main HQ Firewall ────────────────────────────────────────────
  # - name: hq-fw          # registry key used in tool calls (required, unique)
  #   host: https://10.0.0.1  # FortiGate IP or hostname (required)
  #   api_token: your-token-here  # REST API token from FortiGate GUI (required)
  #   vdom: root           # VDOM name (optional, default: root)
  #   verify_ssl: true     # set false for self-signed certs only

  # ── Example: Branch Office Firewall ─────────────────────────────────────
  # - name: branch-fw
  #   host: https://10.1.1.1
  #   api_token: your-token-here
  #   vdom: root
  #   verify_ssl: true

  # ── Example: Lab/Dev Firewall (self-signed cert) ─────────────────────────
  # - name: lab-fw
  #   host: https://192.168.1.1
  #   api_token: your-token-here
  #   vdom: lab-vdom
  #   verify_ssl: false
